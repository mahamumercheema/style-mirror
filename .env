# SMTP & Email Provider Configuration
# Set these to your real SMTP credentials (e.g., Resend, SendGrid, Postmark)
# In development / sandbox without SMTP credentials, verification emails are logged to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Virtual Try Room <noreply@virtualtryroom.com>
AUTH_SECRET=vtr_local_auth_secret_development_key_123
