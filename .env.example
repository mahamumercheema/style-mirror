# SMTP & Email Provider Configuration (e.g., Resend, SendGrid, Gmail, AWS SES)
# If left empty, verification OTP codes will be securely processed and logged in the server console for dev/testing.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=Virtual Try Room <noreply@virtualtryroom.com>

# Authentication Secret for signing tokens
AUTH_SECRET=your_auth_secret_token_here
