// ============================================================================
// Prisma Schema for Style Mirror — AI-Powered Personal Wardrobe Platform
// Database: PostgreSQL (Supabase / Cloud SQL compatible)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  email           String         @unique @db.VarChar(255)
  password_hash   String
  full_name       String?        @db.VarChar(100)
  user_photo_url  String?        @db.Text
  body_type_notes String?        @db.Text
  is_verified     Boolean        @default(false)
  created_at      DateTime       @default(now()) @db.Timestamptz
  updated_at      DateTime       @updatedAt @db.Timestamptz

  wardrobe_items  WardrobeItem[]

  @@map("users")
}

model Category {
  id          Int            @id @default(autoincrement())
  name        String         @unique @db.VarChar(100)
  parent_type String         @db.VarChar(50) // 'Tops', 'Bottoms', 'Full Body / Ethnic', 'Footwear', 'Accessories & Jewelry'
  created_at  DateTime       @default(now()) @db.Timestamptz

  wardrobe_items WardrobeItem[]

  @@map("categories")
}

model Occasion {
  id         Int            @id @default(autoincrement())
  name       String         @unique @db.VarChar(100) // e.g., "Office / Work", "Casual / Daily", "Dinner / Party", "Wedding / Festive / Fancy", "Formal"
  created_at DateTime       @default(now()) @db.Timestamptz

  item_occasions ItemOccasion[]

  @@map("occasions")
}

model WardrobeItem {
  id              String         @id @default(uuid()) @db.Uuid
  user_id         String         @db.Uuid
  category_id     Int?
  title           String         @db.VarChar(150)
  image_url       String         @db.Text
  thumbnail_url   String?        @db.Text
  primary_color   String?        @db.VarChar(50)
  secondary_color String?        @db.VarChar(50)
  fabric_type     String?        @db.VarChar(50)
  season          String         @default("All Season") @db.VarChar(30) // 'Summer', 'Winter', 'All Season'
  is_favorite     Boolean        @default(false)
  created_at      DateTime       @default(now()) @db.Timestamptz
  updated_at      DateTime       @updatedAt @db.Timestamptz

  user            User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category        Category?      @relation(fields: [category_id], references: [id], onDelete: SetNull)
  item_occasions  ItemOccasion[]

  @@index([user_id])
  @@index([category_id])
  @@index([user_id, is_favorite])
  @@index([user_id, season])
  @@map("wardrobe_items")
}

model ItemOccasion {
  item_id     String       @db.Uuid
  occasion_id Int

  wardrobe_item WardrobeItem @relation(fields: [item_id], references: [id], onDelete: Cascade)
  occasion      Occasion     @relation(fields: [occasion_id], references: [id], onDelete: Cascade)

  @@id([item_id, occasion_id])
  @@index([occasion_id, item_id])
  @@map("item_occasions")
}
